 "id_rules": {
  "_note": "How to classify a DISCOVERED id that is not in the curated list. First matching rule wins.",
  "openai": [
   {
    "match": "^gpt-image",
    "modality": "image"
   },
   {
    "match": "^(tts-|gpt-4o-mini-tts|gpt-.*-tts)",
    "modality": "speech"
   },
   {
    "match": "(transcribe|whisper)",
    "modality": "transcription"
   },
   {
    "match": "(gpt-live|search-api|deep-research)",
    "modality": "ignore"
   },
   {
    "match": "(realtime|embedding|moderation|dall-e|sora|babbage|davinci|computer-use|codex-mini|-audio|search-preview|image-)",
    "modality": "ignore"
   },
   {
    "match": "^(gpt-|o[0-9]|chatgpt-)",
    "modality": "text"
   }
  ],
  "google": [
   {
    "match": "-image",
    "modality": "image"
   },
   {
    "match": "-tts",
    "modality": "speech"
   },
   {
    "match": "^lyria",
    "modality": "music"
   },
   {
    "match": "(embedding|imagen|veo|aqa|learnlm|gemma|live|native-audio|omni)",
    "modality": "ignore"
   },
   {
    "match": "^gemini-",
    "modality": "text"
   }
  ],
  "anthropic": [
   {
    "match": "^claude-",
    "modality": "text"
   }
  ],
  "deepseek": [
   {
    "match": "^deepseek",
    "modality": "text"
   }
  ],
  "openrouter": [
   {
    "match": ".",
    "modality": "text"
   }
  ],
  "elevenlabs": [
   {
    "match": "_sts_",
    "modality": "ignore"
   },
   {
    "match": "^eleven_",
    "modality": "speech"
   },
   {
    "match": "^music_",
    "modality": "music"
   },
   {
    "match": "^scribe",
    "modality": "ignore"
   }
  ]
 },
