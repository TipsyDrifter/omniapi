{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniAPI",
  "mainBinaryName": "OmniAPI",
  "version": "1.4.1",
  "identifier": "com.kosa.omniapi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kosa (TipsyDrifter)",
    "copyright": "Copyright (c) 2026 Kosa (TipsyDrifter)",
    "shortDescription": "OmniAPI desktop app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../config/shell.installed.json": "shell.config.json",
      "./nsis-stop.ps1": "nsis-stop.ps1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh",
        "languages": ["TradChinese", "English"]
      }
    }
  }
}
